<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="aruco_marker_2">
    <static>true</static>
    <link name="link">

      <!-- thin backing board -->
      <visual name="board_visual">
        <geometry>
          <box>
            <size>0.20 0.01 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.20 0.01 0.20</size>
          </box>
        </geometry>
      </collision>

      <!-- marker image on front face -->
      <visual name="marker_visual">
        <pose>0.0 0.006 0 -1.570 3.14 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.16 0.16</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <double_sided>true</double_sided>
          <pbr>
            <metal>
              <albedo_map>materials/textures/marker2.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
